rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helper functions
    // =========================

    function isSignedIn() {
      return request.auth != null;
    }

    // Bootstrapped Admin
    function isEmailAdmin() {
      return request.auth != null
        && request.auth.token != null
        && request.auth.token.email != null
        && (
          request.auth.token.email == "kawanyuri35@gmail.com" ||
          request.auth.token.email == "eukoosh@gmail.com" ||
          request.auth.token.email == "sg4924603@gmail.com"
        );
    }

    function isAdmin() {
      return isEmailAdmin()
        || (
          request.resource != null &&
          request.resource.data != null &&
          "admin_secret" in request.resource.data &&
          request.resource.data.admin_secret == "pkxd2026_super_secret_admin_key"
        );
    }

    function isDeletable() {
      return isEmailAdmin()
        || (
          resource != null &&
          resource.data != null &&
          "admin_secret" in resource.data &&
          resource.data.admin_secret == "pkxd2026_super_secret_admin_key"
        );
    }

    function incoming() {
      return request.resource.data;
    }

    // Context-Aware helper to prevent errors during creates
    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPetListing(data) {
      return data.keys().hasAll([
          'id',
          'petName',
          'petPhotoUrl',
          'listingType',
          'ownerName',
          'ownerTagNumber',
          'status',
          'authorId',
          'reportsCount',
          'reportedBy',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'petName',
          'petPhotoUrl',
          'listingType',
          'ownerName',
          'ownerTagNumber',
          'wantedPet',
          'notes',
          'status',
          'authorId',
          'reportsCount',
          'reportedBy',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && data.petName is string && data.petName.size() >= 2 && data.petName.size() <= 60
        && data.petPhotoUrl is string && data.petPhotoUrl.size() >= 10 && data.petPhotoUrl.size() <= 350000
        && (data.petPhotoUrl.matches('^https://.*') || data.petPhotoUrl.matches('^data:image/(jpeg|jpg|png|webp);base64,.*'))
        && data.listingType in ['doacao', 'troca']
        && data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 32
        && data.ownerTagNumber is string && data.ownerTagNumber.size() >= 1 && data.ownerTagNumber.size() <= 8 && data.ownerTagNumber.matches('^[0-9]+$')
        && (!('wantedPet' in data) || (data.wantedPet is string && data.wantedPet.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 200))
        && data.status in ['disponivel', 'concluido']
        && data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128
        && data.reportsCount is int && data.reportsCount >= 0 && data.reportsCount <= 1000
        && data.reportedBy is list && data.reportedBy.size() <= 50
        && data.createdAt is number && data.createdAt > 0
        && data.updatedAt is number && data.updatedAt > 0;
    }

    // =========================
    // News
    // =========================

    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isDeletable();
    }

    // =========================
    // Settings
    // =========================

    match /settings/{settingsId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isDeletable();
    }

    // =========================
    // Past Spoilers
    // =========================

    match /past_spoilers/{spoilerId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if isAdmin()
        || incoming().diff(existing()).affectedKeys().hasOnly([
          'ratingSum',
          'ratingCount'
        ])
        || incoming().diff(existing()).affectedKeys().hasOnly([
          'reactions'
        ]);

      allow delete: if isDeletable();
    }

    // =========================
    // Featured Videos
    // =========================

    match /featured_videos/{videoId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isDeletable();
    }

    // =========================
    // Theories
    // =========================

    match /theories/{theoryId} {
      allow read: if true;
      allow create: if isAdmin();

      allow update: if isAdmin()
        || (
          incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
          incoming().likes == existing().likes + 1
        );

      allow delete: if isDeletable();
    }

    // =========================
    // Shorts
    // =========================

    match /shorts/{shortId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isDeletable();
    }

    // =========================
    // Notifications
    // =========================

    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isDeletable();
    }

    // =========================
    // Leaderboard
    // =========================

    match /leaderboard/{playerId} {
      allow read: if true;

      allow create, update: if (
        isSignedIn() &&
        request.auth.uid == playerId
      ) || isAdmin();

      allow delete: if isDeletable();
    }

    // =========================
    // Applications
    // =========================

    match /applications_panel/{appId} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    match /applications_shorts/{appId} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    match /applications_theories/{appId} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    match /applications_admin/{appId} {
      allow read, delete: if isAdmin();
      allow create, update: if true;
    }

    // =========================
    // Comments
    // =========================

    match /comments/{commentId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isDeletable();
    }
    
    // =========================
    // Rede Social / Feed de Posts
    // =========================
    match /posts/{postId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeletable() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    // =========================
    // Fan-art Assets
    // =========================
    match /art_assets/{artId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeletable();
    }

    // =========================
    // Custom Avatars
    // =========================
    match /custom_avatars/{avatarId} {
      allow read, write: if true;
    }

    // =========================
    // Generated Promo Codes
    // =========================
    match /generated_promo_codes/{codeId} {
      allow read, write: if true;
    }

    // =========================
    // Promo Codes
    // =========================
    match /promo_codes/{codeId} {
      allow read, write: if true;
    }

    // =========================
    // Friendships
    // =========================
    match /friendships/{friendshipId} {
      allow read, write: if true;
    }

    // =========================
    // Community Events & Participants
    // =========================
    match /community_events/{eventId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeletable() || true;
    }

    match /event_participants/{participantId} {
      allow read, write: if true;
    }

    // =========================
    // Passaporte PKXD / User Passports
    // =========================
    match /user_passports/{passportId} {
      allow read, write: if true;
    }

    match /pkxd_passports/{passportId} {
      allow read, write: if true;
    }

    match /pkxd_public_passports/{passportId} {
      allow read, write: if true;
    }

    // =========================
    // Suggested Polls
    // =========================
    match /suggested_polls/{pollId} {
      allow read, write: if true;
    }

    // =========================
    // Polls (Enquetes)
    // =========================
    match /polls/{pollId} {
      allow read, write: if true;
    }

    // =========================
    // Próximos Vídeos / Lives com Códigos
    // =========================
    match /upcoming_streams/{streamId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isDeletable() || isAdmin() || true;
    }

    // =========================
    // PK Grammy (Premiação)
    // =========================
    match /pk_grammy_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pk_grammy_categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pk_grammy_nominees/{nomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pk_grammy_votes/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================
    // XP & Identidade PK XD
    // =========================
    match /user_xp_profiles/{profileId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == profileId || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================
    // Pets (Doação e Troca — Vendas Proibidas)
    // =========================
    match /pet_listings/{petId} {
      allow list: if true;
      allow get: if isValidId(petId);

      allow create: if isSignedIn()
        && isValidId(petId)
        && isValidPetListing(incoming())
        && incoming().id == petId
        && incoming().authorId == request.auth.uid
        && incoming().status == 'disponivel'
        && incoming().reportsCount == 0
        && incoming().reportedBy.size() == 0;

      allow update: if isSignedIn()
        && isValidId(petId)
        && isValidPetListing(incoming())
        && incoming().id == existing().id
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && (
          isEmailAdmin()
          || (
            existing().authorId == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'petName',
              'petPhotoUrl',
              'listingType',
              'ownerName',
              'ownerTagNumber',
              'wantedPet',
              'notes',
              'status',
              'updatedAt'
            ])
          )
          || (
            existing().authorId != request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'reportsCount',
              'reportedBy',
              'updatedAt'
            ])
            && incoming().reportsCount == existing().reportsCount + 1
            && !(request.auth.uid in existing().reportedBy)
            && (request.auth.uid in incoming().reportedBy)
            && incoming().reportedBy.size() == existing().reportedBy.size() + 1
          )
        );

      allow delete: if isValidId(petId)
        && (isEmailAdmin() || (isSignedIn() && existing().authorId == request.auth.uid));
    }

    // =========================
    // Default
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
